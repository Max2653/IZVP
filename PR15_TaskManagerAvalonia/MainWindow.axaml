<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:TaskManager.Models"
        xmlns:s="using:TaskManager.Services"
        x:Class="TaskManager.MainWindow"
        x:DataType="s:TaskList"
        Title="ПР15 — Менеджер завдань (Avalonia UI)"
        Width="540" Height="460"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.done">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="Gray" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Менеджер завдань" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

    <!-- введення нового завдання -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <TextBox x:Name="TitleBox" Watermark="Нове завдання..." KeyDown="TitleBox_KeyDown" />
      <Button Grid.Column="1" Content="Додати" Margin="8,0,0,0" Click="AddButton_Click" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" x:Name="ErrorText" Foreground="#B00020" IsVisible="False" TextWrapping="Wrap" Margin="0,0,0,6" />

    <!-- лічильник і видалення -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding PendingText}" VerticalAlignment="Center" FontWeight="SemiBold" />
      <Button Grid.Column="1" Content="Видалити вибране" Click="DeleteButton_Click" />
    </Grid>

    <!-- список завдань -->
    <ListBox x:Name="TasksList" ItemsSource="{Binding Items}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="m:TaskItem">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                       Classes.done="{Binding IsDone}" Margin="4,0" />
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="DimGray" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
