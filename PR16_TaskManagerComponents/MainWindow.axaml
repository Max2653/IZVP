<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:TaskManager.Models"
        xmlns:s="using:TaskManager.Services"
        xmlns:c="using:TaskManager.Controls"
        x:Class="TaskManager.MainWindow"
        x:DataType="s:TaskList"
        Title="ПР16 — Менеджер завдань (компоненти Avalonia UI)"
        Width="600" Height="460"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Менеджер завдань" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <TextBox x:Name="TitleBox" Watermark="Нове завдання..." KeyDown="TitleBox_KeyDown" />
      <Button Grid.Column="1" Content="Додати" Margin="8,0,0,0" Click="AddButton_Click" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" x:Name="ErrorText" Foreground="#B00020" IsVisible="False" TextWrapping="Wrap" Margin="0,0,0,6" />

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PendingText}" FontWeight="SemiBold" Margin="0,10,0,0" />

    <!-- Один шаблон → один і той самий компонент TaskItemControl для кожного завдання -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:TaskItem">
            <c:TaskItemControl Margin="0,0,0,8"
                               Title="{Binding Title}"
                               IsDone="{Binding IsDone, Mode=TwoWay}"
                               DeleteText="Видалити" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
