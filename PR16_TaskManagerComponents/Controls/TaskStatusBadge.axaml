<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TaskManager.Controls.TaskStatusBadge">
  <!-- Компонент лише відображає статус; колір і текст залежать від властивості IsDone -->
  <Border x:Name="BadgeBorder" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
    <TextBlock x:Name="BadgeText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
  </Border>
</UserControl>
